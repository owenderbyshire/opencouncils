# Copy to .env.local for local development. Never commit real values.

# Postgres (Neon). Use the pooled connection string for the website.
DATABASE_URL=postgres://postgres@localhost:5432/opencouncils
# Direct (non-pooled) connection for migrations and the pipeline.
DATABASE_URL_DIRECT=

# Public URL of the site (canonical links and sitemaps).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the pipeline uses to tell the site to refresh cached pages.
REVALIDATE_SECRET=change-me

# Meeting summaries (Anthropic). Leave blank to switch summaries off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Monthly cap, in pounds, for the pipeline's meeting summaries.
SUMMARY_MONTHLY_BUDGET_GBP=30

# Optional: emails the owner when something needs attention (Resend).
RESEND_API_KEY=
ALERTS_FROM=
ADMIN_EMAIL=

# Pipeline: the site to tell about fresh data (production URL).
SITE_URL=

# Pipeline: read StatsWales through Edau's feed (Edau's address, and OpenCouncil's product key, edau_product_...).
# Leave either empty and the pipeline reads StatsWales itself.
EDAU_FEED_URL=
EDAU_FEED_KEY=
